# Public URL used in generated short_url API fields.
APP_BASE_URL=http://localhost:8080

# HTTP server.
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=10s
HTTP_MAX_BODY_SIZE=16384
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_HEALTHCHECK_TIMEOUT=2s

# CORS. Separate multiple origins with commas.
HTTP_CORS_ALLOW_ORIGINS=*
HTTP_CORS_MAX_AGE=12h

# PostgreSQL.
DATABASE_URL=postgres://shortener:password@localhost:5432/shortener?sslmode=disable
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_MAX_LIFETIME=5m

# Sentry error tracking.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_FLUSH_TIMEOUT=2s
